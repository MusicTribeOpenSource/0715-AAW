             \r\n}                                                                                                    \r\nif \(lastIndex >= 0\) this.selectPageNthWord\(pageIndex, lastIndex, bScroll=false\);                     })/S/JavaScript>>endobj2238 0 obj<</JS(function ShowCompProps_0C0386B46DAF493EBDAACBBFB71097A0\(\){var sChoice = app.popUpMenu\("Agile Part Number: B01-00000-44810","Body Color: Light Brown","Capacitance: 1\\u00B5F","Comment: CL05A105KP5NNNC","Component Kind: Standard","Description: Capacitors\; Ceramics, SMD; 1 uF; 0402 \(1005\)","Dielectric: X5R","Dimension \(LxW,mm\): 1.00x0.50mm","Footprint: CAPC1005X90N_LBROWN","Height \(mm\): 0.55mm","Ibis Model: ","Library Name: Music Tribe Altium365","Library Reference: CMP-00301-32","Manufacturer: Sams\ung Electro-Mechanics Co. Ltd.","Manufacturer Part Number: CL05A105KP5NNNC","Max. Operating Temperature: 85\\u00B0C","Min. Operating Temperature: -55\\u00B0C","Mounting Type: SMD","Number of Capacitors: 1","Number of Pins: 2","Package Type: 0402 \(1005\)"\,"Pb Free \(Yes,No\): Yes","PCB3D: ","Pin Info: ","Pin Pitch \(mm\): N/A","PLM Part Number: CC01-00109-000","Signal Integrity: ","Simulation: ","Tolerance: 10%","Voltage Rating \(DC\): 10V"\); if \(sChoice\) {var nUrlPos = sChoice.search\(/:\\s\(\(http|ht\tps|ftp\):\\/\\/\).+/\); if \(nUrlPos !== -1\) {app.launchURL\(sChoice.substr\(nUrlPos+2\), true\);} else {var nPathPos = sChoice.search\(/:\\s\(\(\\/\)|\(\\\\\\\\\)\).+/\); if \(nPathPos !== -1\) app.openDoc\(sChoice.substr\(nPathPos+2\)\);};};})/S/JavaScript>>endobj2239 0 obj<</JS(function ShowCompProps_3650CFA713F74DB493B1BD905FE68B21\(\){var sChoice = app.popUpMenu\("Agile Part Number: B01-00000-44810","Body Color: Light Brown","Capacitance: 1\\u00B5F","Comment: CL05A105KP5NNNC","Component Kind: Standard","Description: Capacitors\; Ceramics, SMD; 1 uF; 0402 \(1005\)","Dielectric: X5R","Dimension \(LxW,mm\): 1.00x0.50mm","Footprint: CAPC1005X90N_LBROWN","Height \(mm\): 0.55mm","Ibis Mode